APP_NAME="Chefni AI API"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
DB_DATABASE=database/database.sqlite

BROADCAST_DRIVER=log
CACHE_DRIVER=file
FILESYSTEM_DISK=local

# Video processing runs out of band. With `sync` the upload request blocks
# until FFmpeg finishes, which exceeds the client timeout on any real video.
# Run a worker alongside the app:
#   php artisan queue:work --queue=video,default --timeout=900
QUEUE_CONNECTION=database
SESSION_DRIVER=file
SESSION_LIFETIME=120

MEMCACHED_HOST=127.0.0.1

REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="noreply@chefni.com"
MAIL_FROM_NAME="${APP_NAME}"

STRIPE_KEY=
STRIPE_SECRET=

# ── OTP delivery (WhatsApp Business API) ─────────────────────────────────
# Without these, OTP codes are written to the log instead of sent — fine for
# local dev, never set this up for production and skip real delivery.
CHEFNI_DEMO_LOGIN=false
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_OTP_TEMPLATE=otp_code
WHATSAPP_OTP_TEMPLATE_LANG=en
WHATSAPP_API_VERSION=v21.0

# ── Media toolchain ──────────────────────────────────────────────────────
# Absolute paths are safest on Windows and on hosts with a trimmed PATH.
FFMPEG_BINARY=ffmpeg
FFPROBE_BINARY=ffprobe

# ── AI recipe extraction ─────────────────────────────────────────────────
# Without these the pipeline still produces reels; it stops before the recipe
# card and says so on the video record.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5
OPENAI_API_KEY=
OPENAI_TRANSCRIPTION_MODEL=whisper-1
